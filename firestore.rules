// Firestore security rules
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // الطلاب
    match /students/{nid} {
      // القراءة: مسموحة للجميع (تقدر تقفلها لاحقًا)
      allow read: if true;

      // الكتابة: فقط حساب المشرف (بريد واحد محدد) — عدّل البريد بالأسفل
      allow write: if request.auth != null
                   && request.auth.token.email == "you@example.com";
    }

    // افتراضيًا: منع أي شيء غير معروف
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
